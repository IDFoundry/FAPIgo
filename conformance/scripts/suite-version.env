# The OIDF conformance suite release FAPIgo's conformance runs use:
# .github/workflows/conformance.yml clones SUITE_TAG and checks it is at
# SUITE_COMMIT, and run-all.sh warns when a local suite checkout isn't.
# suite-pinned.override.yml pins the same release's images by digest.
#
# Moving the pin moves all three together: SUITE_TAG, SUITE_COMMIT and
# the image digests in suite-pinned.override.yml. The workflow's
# newer-suite job fails while a newer release is out. Review the
# release's changes first (git log OLD_TAG..NEW_TAG in a suite clone).
#
# Sourced by shell scripts, so plain NAME=value lines only.
SUITE_TAG=release-v5.3.5
SUITE_COMMIT=246b2c14b8562012b02d0ac462d667fe49e1a937
