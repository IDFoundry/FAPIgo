{
  "listen_addr": "0.0.0.0:8443",
  "issuer": "https://conformance-as-message-signing:8443",
  "profile": "fapi2-security-message-signing",
  "default_subject": "conformance-test-user",

  "algorithms": {
    "client_assertion": ["ES256"],
    "request_object": ["ES256"],
    "jarm": "ES256",
    "access_token": "ES256",
    "id_token": "ES256"
  },

  "limits": {
    "pushed_request_lifetime_seconds": 90,
    "max_client_assertion_lifetime_seconds": 60,
    "max_request_object_lifetime_seconds": 600,
    "interaction_lifetime_seconds": 300,
    "authorization_code_lifetime_seconds": 60,
    "jarm_response_lifetime_seconds": 60,
    "access_token_lifetime_seconds": 300,
    "id_token_lifetime_seconds": 300,
    "refresh_token_lifetime_seconds": 3600,
    "max_dpop_proof_age_seconds": 60,
    "max_clock_skew_seconds": 15
  },

  "clients": [
    {
      "id": "gofapi-conformance-client-1",
      "redirect_uris": [
        "https://localhost.emobix.co.uk:8443/test/a/gofapi-msgsign/callback",
        "https://localhost.emobix.co.uk:8443/test/a/gofapi-msgsign/callback?dummy1=lorem&dummy2=ipsum"
      ],
      "client_assertion_algorithm": "ES256",
      "request_object_algorithm": "ES256",
      "allowed_scopes": ["openid", "accounts", "offline_access"],
      "jwks": {
        "keys": [
          {
            "alg": "ES256",
            "crv": "P-256",
            "kid": "gofapi-conformance-msgsign-client1-key1",
            "kty": "EC",
            "use": "sig",
            "x": "rPYEjGXoaI1-JiWaZ-6F1d06Fo_FMbML6dhDFZxAoho",
            "y": "OcgHqhWB5Slkl0LR4wI91UH2R00EJdz_CYafsrgPc4A"
          }
        ]
      }
    },
    {
      "id": "gofapi-conformance-client-2",
      "redirect_uris": [
        "https://localhost.emobix.co.uk:8443/test/a/gofapi-msgsign/callback",
        "https://localhost.emobix.co.uk:8443/test/a/gofapi-msgsign/callback?dummy1=lorem&dummy2=ipsum"
      ],
      "client_assertion_algorithm": "ES256",
      "request_object_algorithm": "ES256",
      "allowed_scopes": ["openid", "accounts", "offline_access"],
      "jwks": {
        "keys": [
          {
            "alg": "ES256",
            "crv": "P-256",
            "kid": "gofapi-conformance-msgsign-client2-key1",
            "kty": "EC",
            "use": "sig",
            "x": "rNhZck-Ne38WZUJgH2bvr3z00gMiQmK1R0AakX8A6SA",
            "y": "oLRM9gDUKrJyG2gc8xI7b6ho-SZlzl-qd2IC1U6jk-A"
          }
        ]
      }
    }
  ]
}
