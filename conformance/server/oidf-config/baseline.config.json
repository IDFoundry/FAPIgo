{
  "listen_addr": "0.0.0.0:8443",
  "issuer": "https://conformance-as-baseline:8443",
  "profile": "fapi2-security",
  "default_subject": "conformance-test-user",
  "algorithms": {
    "client_assertion": [
      "ES256"
    ],
    "request_object": [
      "ES256"
    ],
    "access_token": "ES256",
    "id_token": "ES256"
  },
  "limits": {
    "pushed_request_lifetime_seconds": 90,
    "max_client_assertion_lifetime_seconds": 60,
    "max_request_object_lifetime_seconds": 60,
    "interaction_lifetime_seconds": 300,
    "authorization_code_lifetime_seconds": 60,
    "access_token_lifetime_seconds": 300,
    "id_token_lifetime_seconds": 300,
    "refresh_token_lifetime_seconds": 3600,
    "max_dpop_proof_age_seconds": 60,
    "max_clock_skew_seconds": 15
  },
